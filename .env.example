PORT=4000
NODE_ENV=production

# MongoDB connection string
MONGO_URI=mongodb://mongo:27017/wirebase

# The master key for the single Admin account. Whoever has this key can log in as Admin -
# there is no Admin row in the database; this key IS the Admin identity.
ADMIN_API_KEY=change-this-to-a-long-random-admin-key

# Session cookie signing secret (sessions are stored in MongoDB via connect-mongo, not JWT)
SESSION_SECRET=change-this-to-a-long-random-session-secret

# Where Baileys auth sessions are written, one subfolder per instance
SESSIONS_DIR=./sessions

# Public base URL of this app - used to build the site cookie / CORS / the Developers section's code samples
PUBLIC_BASE_URL=http://localhost:4000

# Set to "true" to auto-refresh the free proxy pool on startup and every PROXY_REFRESH_MINUTES
ENABLE_FREE_PROXIES=true
PROXY_REFRESH_MINUTES=30
